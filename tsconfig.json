{
    "compilerOptions": {
      "lib": [
          "ES2017",
          "webworker"
      ],
      "sourceMap": true,
      "rootDir": "src",
      "outDir": "dist",
      "module": "Node16",
      "esModuleInterop": true,
      "target": "ESNext",
      "moduleResolution": "Node16",
      "skipLibCheck": true,
      "allowSyntheticDefaultImports": true,
      "types": [
          "node",
      ],
      "paths": {
        "/@rhaccm": ["./src-gen/rhaccm-schema.ts"]
      }
    },
    "include": [
        "src",
        "src-gen"
    ],
    "ts-node": {
      "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node16"
      }
    }
  }

